<Layouts.app flash={@flash}>
  <h1 class="text-2xl font-bold mb-4">Vídeo {@video.id}</h1>

  <p><strong>ID:</strong> {@video.id}</p>
  <p><strong>Título:</strong> {@video.title}</p>
  <p><strong>URL:</strong> <a href={@video.url} target="_blank" class="link">{@video.url}</a></p>

  <div class="mt-4 max-w-3xl aspect-video">
    <iframe
      class="w-full h-full"
      src={@video.url}
      title={@video.title}
      frameborder="0"
      allowfullscreen
    >
    </iframe>
  </div>
</Layouts.app>
